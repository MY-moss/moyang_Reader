{
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        "default",
        {
          "identifier": "wdio",
          "description": "WebdriverIO-only permissions for real desktop smoke tests",
          "windows": ["main"],
          "permissions": [
            "wdio:default",
            "wdio-webdriver:default",
            "core:event:allow-emit"
          ]
        }
      ]
    }
  }
}
