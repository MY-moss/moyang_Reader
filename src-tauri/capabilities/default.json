{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for Moyang Reader",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "fs:allow-watch",
    "process:default",
    "updater:default",
    {
      "identifier": "fs:scope",
      "allow": ["**"]
    }
  ]
}
