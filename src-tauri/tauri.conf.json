{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Moyang Reader",
  "version": "0.5.1",
  "identifier": "com.moyang.reader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Moyang Reader",
        "width": 1240,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: http: https: data:; frame-src 'self' blob: http: https: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFBM0NEQkQxNDdGNkQ2RDAKUldUUTF2WkgwZHM4cW9qWUlqb0pHSnpnQ0NDR3I5ZTRkdy9reS8zUzNaVlNtcTl5a29SKzllYlIK",
      "endpoints": [
        "https://github.com/MY-moss/moyang_Reader/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd"],
        "name": "Markdown 文档",
        "description": "使用 Moyang Reader 阅读 Markdown 文档",
        "role": "Editor",
        "mimeType": "text/markdown"
      }
    ]
  }
}
