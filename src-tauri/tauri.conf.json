{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Moyang Reader Next",
  "version": "0.16.0",
  "identifier": "com.moyang.reader.next",
  "build": {
    "beforeDevCommand": "node scripts/tauri-dev-server.mjs",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Moyang Reader Next",
        "width": 1240,
        "height": 820,
        "minWidth": 720,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost blob:; worker-src 'self' blob:; img-src 'self' blob: http: https: data:; frame-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' blob: 'wasm-unsafe-eval'",
      "capabilities": [
        "default"
      ]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUxOUNBMjlFNUIyN0YzODIKUldTQzh5ZGJucUtjVWZ6Yk9WYk5XVWpIYzZGMEU3NXZ3a0ZaVWlubnpFbGMrQ3VpRmlUU2dJMUEK",
      "endpoints": [
        "https://github.com/MY-moss/moyang_Reader/releases/latest/download/reader-update.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "fileAssociations": []
  }
}
