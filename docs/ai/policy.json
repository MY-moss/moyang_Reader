{
  "schemaVersion": 1,
  "planId": "moyang-v1",
  "maxAutoRisk": "T2",
  "approvalDirectory": "docs/ai/approvals",
  "allowedAutomaticActions": [
    "commit",
    "push",
    "open_pull_request",
    "enable_auto_merge",
    "merge_pull_request",
    "update_linked_issue"
  ],
  "blockedAutomaticActions": [
    "implement_t3",
    "create_release",
    "create_tag",
    "change_credentials",
    "change_permissions",
    "change_governance",
    "run_data_migration"
  ],
  "protectedPaths": [
    { "match": "exact", "path": "AGENTS.md" },
    { "match": "exact", "path": "docs/ai/policy.json" },
    { "match": "exact", "path": "docs/ai/plan-v1.json" },
    { "match": "prefix", "path": "docs/ai/approvals/" },
    { "match": "exact", "path": ".github/CODEOWNERS" },
    { "match": "prefix", "path": ".github/workflows/" },
    { "match": "exact", "path": "scripts/ai-context-check.mjs" },
    { "match": "exact", "path": "scripts/ai-context-check.test.mjs" },
    { "match": "exact", "path": "scripts/ai-state.mjs" },
    { "match": "exact", "path": "scripts/ai-state.test.mjs" },
    { "match": "exact", "path": "scripts/cleanup-workspace.mjs" },
    { "match": "exact", "path": "scripts/cleanup-workspace.test.mjs" },
    { "match": "exact", "path": "docs/WORKSPACE-CLEANUP.md" },
    { "match": "exact", "path": "docs/RELEASE-POLICY.md" },
    { "match": "exact", "path": "SECURITY.md" }
  ],
  "stateTransitions": {
    "PENDING_INTAKE": ["READY", "BLOCKED", "AWAITING_APPROVAL"],
    "READY": ["IN_PROGRESS", "BLOCKED", "AWAITING_APPROVAL"],
    "IN_PROGRESS": ["VERIFYING", "BLOCKED", "AWAITING_APPROVAL"],
    "VERIFYING": ["DELIVERY_READY", "BLOCKED", "AWAITING_APPROVAL"],
    "DELIVERY_READY": ["PENDING_INTAKE", "BLOCKED"],
    "BLOCKED": ["PENDING_INTAKE", "READY", "AWAITING_APPROVAL"],
    "AWAITING_APPROVAL": ["READY", "BLOCKED"]
  }
}
