{
  "name": "moyang-reader-next",
  "version": "0.18.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"docs/**/*.md\" \"tasks/*.md\" \"README.md\" \"e2e/*.ts\"",
    "preview": "vite preview",
    "desktop": "node scripts/run-tauri.mjs dev",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:desktop": "node scripts/test-desktop-e2e.mjs",
    "test:watch": "vitest",
    "tauri": "node scripts/run-tauri.mjs",
    "rust": "node scripts/run-cargo.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check": "npm run check:architecture && node scripts/export-extension-catalog.mjs --check && npm run lint && npm test && npm run test:scripts && npm run build",
    "test:scripts": "node --test scripts/*.test.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"docs/**/*.md\" \"tasks/*.md\" \"README.md\" \"e2e/*.ts\"",
    "build:mcp": "node scripts/build-mcp.mjs",
    "test:ai": "node scripts/run-cargo.mjs test --workspace",
    "predev": "node scripts/sync-pdfjs-assets.mjs",
    "prebuild": "node scripts/sync-pdfjs-assets.mjs",
    "start": "powershell.exe -NoProfile -File scripts/start-reader.ps1",
    "package": "node scripts/package-portable.mjs",
    "clean:preview": "powershell.exe -NoProfile -File scripts/clean-workspace.ps1",
    "clean": "powershell.exe -NoProfile -File scripts/clean-workspace.ps1 -Apply",
    "archive:preview": "powershell.exe -NoProfile -File scripts/archive-releases.ps1",
    "archive": "powershell.exe -NoProfile -File scripts/archive-releases.ps1 -Apply"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/search": "^6.7.1",
    "@milkdown/kit": "7.22.1",
    "@milkdown/react": "7.22.1",
    "@mozilla/readability": "^0.6.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "codemirror": "^6.0.2",
    "jszip": "^3.10.1",
    "katex": "^0.19.0",
    "lucide-react": "1.57.0",
    "mammoth": "^1.8.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rehype-katex": "^7.0.1",
    "rehype-parse": "^9.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "katex": "$katex"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@wdio/cli": "^9.31.3",
    "@wdio/local-runner": "^9.31.3",
    "@wdio/mocha-framework": "^9.31.2",
    "@wdio/spec-reporter": "^9.31.2",
    "@wdio/tauri-plugin": "^1.3.0",
    "@wdio/tauri-service": "^1.3.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^25.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  }
}
