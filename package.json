{
  "name": "moyang-reader",
  "version": "0.10.14",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"eslint.config.mjs\" \".prettierrc.json\" \"*.md\" \".github/**/*.{md,yml,yaml}\" \"docs/**/*.{json,md}\" \"scripts/*.mjs\" \"desktop-e2e/*.mjs\"",
    "preview": "vite preview",
    "desktop": "node scripts/run-tauri.mjs dev",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --config vite.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:a11y": "playwright test e2e/a11y.spec.ts",
    "test:e2e:desktop": "node scripts/test-desktop-e2e.mjs",
    "test:watch": "vitest",
    "test:workflow": "node --test scripts/ai-context-check.test.mjs scripts/ai-state.test.mjs scripts/cleanup-workspace.test.mjs scripts/prepare-worktree.test.mjs scripts/shared-cargo-target.test.mjs scripts/style-token-check.test.mjs",
    "test:release": "node --test scripts/release-check.test.mjs scripts/release-status-check.test.mjs scripts/prepare-mirror.test.mjs scripts/check-action-pins.test.mjs scripts/documentation-check.test.mjs",
    "check:actions": "node scripts/check-action-pins.mjs",
    "check:docs": "node scripts/documentation-check.mjs",
    "ai:context": "node scripts/ai-state.mjs context",
    "ai:start": "node scripts/ai-state.mjs start",
    "ai:check": "node scripts/ai-context-check.mjs",
    "ai:render": "node scripts/ai-state.mjs render",
    "ai:finish": "node scripts/ai-state.mjs finish",
    "check:ai-context": "npm run ai:check",
    "check:build-artifacts": "node scripts/check-build-artifacts.mjs",
    "check:type-aware": "node scripts/check-type-aware-eslint.mjs",
    "cleanup:workspace": "node scripts/cleanup-workspace.mjs",
    "worktree:prepare": "node scripts/prepare-worktree.mjs",
    "tauri": "node scripts/run-tauri.mjs",
    "rust": "node scripts/run-cargo.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release:status": "node scripts/release-status-check.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/search": "^6.7.1",
    "@milkdown/kit": "7.22.1",
    "@milkdown/react": "7.22.1",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "codemirror": "^6.0.2",
    "jszip": "^3.10.1",
    "katex": "^0.16.11",
    "mammoth": "^1.8.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rehype-katex": "^7.0.1",
    "rehype-parse": "^9.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@wdio/cli": "^9.31.3",
    "@wdio/local-runner": "^9.31.5",
    "@wdio/mocha-framework": "^9.31.2",
    "@wdio/spec-reporter": "^9.31.2",
    "@wdio/tauri-plugin": "^1.3.0",
    "@wdio/tauri-service": "^1.3.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^25.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
